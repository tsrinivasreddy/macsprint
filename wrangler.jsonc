{
  // MacSprint website + waitlist API. See docs/DEPLOY.md.
  "name": "mac-sprint",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node tools/build-site.mjs" },
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "routes": [
    { "pattern": "macsprint.com", "custom_domain": true },
    { "pattern": "www.macsprint.com", "custom_domain": true }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "macsprint-waitlist", "database_id": "4c9f2854-adb0-4937-95d6-b7104c528faa" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  // NOTIFY_TO (your own inbox, verified in Email Routing) is set in the dashboard: Settings → Variables and secrets.
  "keep_vars": true,
  "vars": {
    "MAIL_FROM": "waitlist@macsprint.com"
  },
  "observability": { "enabled": true }
}
